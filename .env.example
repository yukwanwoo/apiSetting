# Node.js >=22. This file is not loaded automatically; use node --env-file=.env src/server.js.
HOST=127.0.0.1
PORT=3000
# Optional: generated locally in data/keys.json when absent.
# ADMIN_TOKEN=
# OVERLAY_TOKEN=
# WEBHOOK_SECRET=
# OAuth 2.0 token with youtube.readonly scope. Set securely; never commit values.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# Alternative temporary access token (expires):
# YOUTUBE_ACCESS_TOKEN=
# Optional live chat ID; auto-discovers one active authenticated broadcast otherwise.
# YOUTUBE_LIVE_CHAT_ID=
# DATA_DIR=/absolute/path/to/persistent/data
