# Node.js >=24. This file is not loaded automatically; use node --env-file=.env src/server.js.
HOST=127.0.0.1
PORT=3000
# Optional: generated locally in data/keys.json when absent.
# ADMIN_TOKEN=
# OVERLAY_TOKEN=
# WEBHOOK_SECRET=
# OAuth 2.0 token with youtube.readonly scope. Set securely; never commit values.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# Alternative temporary access token (expires):
# YOUTUBE_ACCESS_TOKEN=
# Optional live chat ID; auto-discovers one active authenticated broadcast otherwise.
# YOUTUBE_LIVE_CHAT_ID=
# DATA_DIR=/absolute/path/to/persistent/data

# CHZZK: service operator's developer app; broadcaster uses account consent UI.
# Enable user-info read and donation read scopes in the developer console.
# CHZZK_CLIENT_ID=
# CHZZK_CLIENT_SECRET=
# Optional bootstrap credentials; rotating refresh tokens are persisted in data/.
# CHZZK_ACCESS_TOKEN=
# CHZZK_REFRESH_TOKEN=
# Public HTTPS origin (localhost HTTP is allowed for development).
# PUBLIC_BASE_URL=https://roulette.example.com
